[Unit]
Description=GAIA ↔ TouchDesigner OSC Bridge
After=network.target mosquitto.service

[Service]
Type=simple
User=core
WorkingDirectory=/home/core/core-node-0/minipc/touchdesigner
ExecStart=/home/core/core-node-0/venv/bin/python3 /home/core/core-node-0/minipc/touchdesigner/osc_bridge.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/core
# Override in /etc/gaia/touchdesigner.conf: TD_OSC_PORT,
# TD_EVENT_OSC_PORT, OSC_IN_PORT, SEND_INTERVAL_MS, MQTT_HOST,
# GAIA_WS_HOST/PORT — vedi config.py per i default. Niente TD_OSC_HOST: le
# istanze TD si scoprono via MQTT (TDDeviceRegistry in osc_bridge.py).

[Install]
WantedBy=multi-user.target
