[Unit]
Description=GAIA LiveStream — il Pi trasmette (mic/libreria) via icecast2 locale
After=network-online.target sound.target icecast2.service
Wants=icecast2.service
# Gestito da gaia-agent — NON abilitare con systemctl enable

[Service]
Type=simple
User=asemico
WorkingDirectory=/home/asemico/gaia/livestream
EnvironmentFile=/etc/gaia/device.conf
EnvironmentFile=-/etc/gaia/livestream.conf
# Richiesto da ffmpeg -f alsa -i default: passa dal plugin ALSA di PipeWire
# (pipewire-alsa), che senza questa var non trova il socket della sessione
# PipeWire dell'utente — fallisce con "cannot open audio device default
# (Host is down)" invece di un errore più chiaro (bug dal vivo 2026-08-14
# su vsrasp01, stesso principio del fix già fatto per herbarium).
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/asemico/gaia/livestream/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
