# GAIA DMX (base) — configurazione
# Copia in /etc/gaia/dmx.conf e modifica per ogni Raspberry Pi

# Broker MQTT -- di default un mosquitto LOCALE su questo stesso Pi
# (installato da install.sh, "[3/3]"), cosi' il servizio e le pagine web
# locali funzionano anche senza rete verso Core (pensato per uso "in
# giro"/touring). Un bridge verso il broker di Core si collega da solo
# quando raggiungibile -- niente da cambiare qui per quello, è
# configurato a parte in /etc/mosquitto/conf.d/gaia-dmx-broker.conf
# (target CORE_MQTT_HOST, passato all'invocazione di install.sh se
# diverso dal default 192.168.1.142). Cambia questo valore SOLO se vuoi
# che il servizio parli dritto con un broker esterno, bypassando il
# locale e la relativa resilienza offline.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Nodo Art-Net di destinazione (es. l'IP di un dimmer/driver RGB in rete).
# OBBLIGATORIO -- senza questo il servizio gira (palette/timeline/status
# funzionano via MQTT) ma non manda nessun pacchetto Art-Net, mai un valore
# indovinato qui. Verifica l'IP reale del nodo prima di impostarlo (es. dal
# pannello del driver stesso, o con uno scan Art-Net se disponibile).
ARTNET_HOST=
ARTNET_PORT=6454

# IP statico (CIDR) che pi/agent/agent.py (e il toggle del portale
# gaia-provision) mettono sulla porta Ethernet DMX SOLO mentre questo
# servizio è attivo (nmcli, mai in competizione col WiFi per la default
# route) -- molte reti Art-Net non hanno DHCP. Deve stare nella stessa
# subnet del nodo sopra; su un'altra rete Art-Net, o un altro Pi sulla
# STESSA rete, serve un indirizzo diverso -- mai un default indovinato.
# Quando il servizio è spento, quella porta torna da sola a DHCP normale.
DMX_ETH_ADDRESS=

# Nome del device (es. 'eth1') SOLO se questo Pi ha PIÙ di una porta
# Ethernet e vuoi dedicarne una al DMX lasciando l'altra (es. eth0)
# sempre libera per la LAN normale -- trovato dal vivo 2026-10-15 su Pi
# Ingresso (NIC USB aggiuntivo). Senza questa riga, "la prima Ethernet
# trovata" è un indovinello che con due porte potrebbe scegliere quella
# sbagliata e staccare la LAN invece della rete Art-Net -- mai un
# default indovinato, stesso principio di DMX_ETH_ADDRESS. Lascia vuoto
# se questo Pi ha solo una porta Ethernet (comportamento storico).
DMX_ETH_IFACE=

# Indirizzamento Art-Net a 3 campi -- lascia a 0 se la rete ha un solo
# universo (caso comune per una fixture singola).
ARTNET_NET=0
ARTNET_SUBNET=0
ARTNET_UNIVERSE=0

# Canali della fixture pilotata: 3=RGB, 4=RGBW (il 4° canale resta sempre a
# 0 in questa versione "base", nessun mixing automatico del bianco).
# START_ADDRESS è il primo canale DMX (1-512) nell'universo -- 1 se la
# fixture è sola nel suo universo, un valore diverso se condivide
# l'universo con altre fixture patchate altrove.
DMX_NUM_CHANNELS=3
DMX_START_ADDRESS=1

# Refresh dell'uscita Art-Net (Hz). Non superare ~44Hz (limite di spec
# Art-Net 4) -- stesso limite già rispettato lato TD per DMX V8.
DMX_FPS=30

DMX_STATUS_EVERY_S=5
